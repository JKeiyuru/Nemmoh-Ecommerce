# server/.env.example
# Copy to .env and fill in real values. Never commit the real .env file.

# ── Database ──────────────────────────────────────────────────────────────
MONGODB_URI=

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=https://kenyamagictoyshop.com
JWT_SECRET=

# ── Firebase Admin (for Firebase-authenticated accounts + password reset) ──
# Paste the full contents of your Firebase service-account JSON as one line,
# or set individual fields — whichever your firebase-admin.js expects.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Cloudinary (product images) ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Brevo (transactional email — replaces the old cPanel SMTP setup) ───────
# Get this from Brevo → Settings → SMTP & API → API Keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@kenyamagictoyshop.com
BREVO_SENDER_NAME=Kenya Magic Toy Shop
WHATSAPP_NUMBER=254799654321

# ── Paystack (replaces PayPal / M-Pesa) ─────────────────────────────────────
# Get these from the Paystack dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
